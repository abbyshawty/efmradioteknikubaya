# ============================================================
#  Salin file ini menjadi  .env.local  lalu isi nilainya.
#  Di Vercel: masukkan variabel ini di menu
#  Settings > Environment Variables (JANGAN commit .env.local).
# ============================================================

# Password untuk login ke halaman admin (/admin). GANTI dengan yang kuat.
ADMIN_PASSWORD=ganti-password-ini

# Kunci rahasia untuk menandatangani sesi login admin (cookie).
# Bebas isi apa saja asal panjang & acak, mis. hasil dari:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kalau tidak diisi, sistem otomatis pakai ADMIN_PASSWORD sebagai fallback
# (tetap jalan, tapi kurang ideal -- sebaiknya diisi terpisah).
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-panjang

# Kredensial Upstash Redis (untuk menyimpan konfigurasi situs secara
# permanen, termasuk sesi login & rate limiting). Dapatkan dari
# https://console.upstash.com > buat database Redis > tab "REST API".
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=token-rahasia-dari-upstash

# Token Vercel Blob (untuk upload foto lewat halaman admin). Di dashboard
# Vercel: Storage > Create Database > Blob > buat store > token ini otomatis
# muncul sebagai environment variable begitu store terhubung ke proyek.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
