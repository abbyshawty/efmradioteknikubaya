# ============================================================
#  Salin file ini menjadi  .env.local  lalu isi nilainya.
#  Di Vercel/Netlify: masukkan variabel ini di menu
#  Settings > Environment Variables (JANGAN commit .env.local).
# ============================================================

# Password untuk halaman admin (/admin). GANTI dengan yang kuat.
ADMIN_PASSWORD=ganti-password-ini

# Kredensial Upstash Redis (untuk menyimpan konfigurasi situs secara
# permanen). Dapatkan dari https://console.upstash.com > buat database
# Redis > tab "REST API".
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=token-rahasia-dari-upstash
